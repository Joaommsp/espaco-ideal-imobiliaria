# Banco (o container publica em DB_PORT para você inspecionar de fora)
POSTGRES_USER=espacoideal
POSTGRES_PASSWORD=espacoideal
POSTGRES_DB=espacoideal
DB_PORT=2005

# Portas publicadas no host
API_PORT=2002
SITE_PORT=2000
ADMIN_PORT=2001

# Firebase — projeto dos clientes (usado pelo site e pelo painel).
# A chave web é pública por natureza: ela chega ao navegador no bundle. O que
# protege os dados são as regras de segurança do projeto e a restrição de
# domínio da chave no Google Cloud Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase — projeto dos administradores (usado só pelo painel)
NEXT_PUBLIC_FIREBASE_ADMIN_API_KEY=
NEXT_PUBLIC_FIREBASE_ADMIN_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_ADMIN_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_ADMIN_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_ADMIN_SENDER_ID=
NEXT_PUBLIC_FIREBASE_ADMIN_APP_ID=
